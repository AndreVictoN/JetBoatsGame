# This .gitignore file is outside the Unity project,
# which is located in the JetBoats directory.

.utmp/

# Unity generated folders
/JetBoats/[Ll]ibrary/
/JetBoats/[Tt]emp/
/JetBoats/[Oo]bj/
/JetBoats/[Bb]uild/
/JetBoats/[Bb]uilds/
/JetBoats/[Ll]ogs/
/JetBoats/[Uu]ser[Ss]ettings/

*.log

# Blender
*.blend1
*.blend1.meta

# MemoryCaptures
/JetBoats/[Mm]emoryCaptures/

# Recordings
/JetBoats/[Rr]ecordings/

# Asset Store Tools
# /JetBoats/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/JetBoats/[Aa]ssets/Plugins/Editor/JetBrains*

# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/JetBoats/ExportedObj/
/JetBoats/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
/JetBoats/InitTestScene*.unity*

# Addressables default ignores
/JetBoats/ServerData/
/JetBoats/[Aa]ssets/StreamingAssets/aa*
/JetBoats/[Aa]ssets/AddressableAssetsData/link.xml*
/JetBoats/[Aa]ssets/Addressables_Temp*
/JetBoats/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/JetBoats/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/JetBoats/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/JetBoats/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property\ Providers
/JetBoats/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property\ Providers.meta

# Auto-generated scenes by play mode tests
/JetBoats/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/JetBoats/[Aa]ssets/[Ss]ceneDependencyCache*